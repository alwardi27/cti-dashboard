NVD_API_KEY=
GITHUB_TOKEN=
VULNCHECK_API_TOKEN=
THREATFOX_AUTH_KEY=
URLHAUS_AUTH_KEY=
MALWAREBAZAAR_AUTH_KEY=
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Optional query/feed controls.
VIRUSTOTAL_QUERY=
GREYNOISE_QUERY=classification:malicious last_seen:1d
SHODAN_QUERY=has_vuln:true
CENSYS_QUERY=services.software.uniform_resource_identifier:*
ABUSEIPDB_CONFIDENCE_MINIMUM=90
ABUSEIPDB_LIMIT=1000

# CORS defaults to same-origin plus localhost/127.0.0.1 browser origins.
# Set comma-separated exact origins only if you host the UI separately.
CTI_CORS_ORIGINS=

# WhatsApp alerts via Twilio.
# Alerts are queued for newly inserted high/critical CVEs and sent only when enabled.
WHATSAPP_ALERTS_ENABLED=false
WHATSAPP_PROVIDER=twilio
WHATSAPP_MIN_SEVERITY=high
WHATSAPP_ALERT_MAX_AGE_DAYS=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_ALERT_TO=whatsapp:+971000000000

# Microsoft Teams progress notifications.
# Use a Teams Workflows webhook URL or compatible incoming webhook URL.
TEAMS_ALERTS_ENABLED=false
TEAMS_WEBHOOK_URL=
# adaptive_card matches Teams incoming webhook card payloads. Use text for simple
# Teams Workflow templates that expect a JSON body with a text property.
TEAMS_WEBHOOK_FORMAT=adaptive_card
TEAMS_WEBHOOK_TIMEOUT_MS=15000
TEAMS_WEBHOOK_MAX_ATTEMPTS=2
TEAMS_WEBHOOK_RETRY_DELAY_MS=500
