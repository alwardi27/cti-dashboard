NVD_API_KEY=
GITHUB_TOKEN=
VULNCHECK_API_TOKEN=
THREATFOX_AUTH_KEY=
URLHAUS_AUTH_KEY=
MALWAREBAZAAR_AUTH_KEY=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Local runtime controls.
# CTI_DB_PATH defaults to ./data/cti.db when unset.
CTI_DB_PATH=
CTI_ENABLE_SCHEDULER=false

# Optional query/feed controls.
FEODO_ENABLED=false
SSLBL_ENABLED=true
EPSS_ENABLED=true
EPSS_MIN_SCORE=0.05
EPSS_LIMIT=1000
OSV_ENABLED=true
OSV_LIMIT=50
MALWAREBAZAAR_HOURS=48
NVD_DAYS_BACK=3
URLHAUS_LIMIT=200
THREATFOX_DAYS=1
VIRUSTOTAL_QUERY=
VIRUSTOTAL_ENRICH_LIMIT=25
FEED_TIMEOUT_MS=90000
FEED_RETRIES=3
FEED_RETRY_DELAY_MS=1500
GREYNOISE_QUERY=classification:malicious last_seen:1d
VULNCHECK_INDEX=
VULNCHECK_LIMIT=200
SHODAN_QUERY=has_vuln:true
SHODAN_PAGE=1
SHODAN_MINIFY=false
CENSYS_QUERY=services.software.uniform_resource_identifier:*
ABUSEIPDB_CONFIDENCE_MINIMUM=90
ABUSEIPDB_LIMIT=1000
ABUSEIPDB_IP_VERSION=
OTX_LIMIT=50
OTX_PAGE=1
OTX_MODIFIED_SINCE_HOURS=24

# WhatsApp alerts via Twilio.
# Alerts are queued for newly inserted high/critical CVEs and sent only when enabled.
WHATSAPP_ALERTS_ENABLED=false
WHATSAPP_PROVIDER=twilio
WHATSAPP_MIN_SEVERITY=high
WHATSAPP_ALERT_MAX_AGE_DAYS=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_ALERT_TO=whatsapp:+971000000000

# Microsoft Teams progress notifications.
# Use a Teams Workflows webhook URL or compatible incoming webhook URL.
TEAMS_ALERTS_ENABLED=false
TEAMS_WEBHOOK_URL=
